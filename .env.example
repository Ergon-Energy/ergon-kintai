# Supabase（Project Settings → API）
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Slack アプリの Signing Secret（Basic Information → App Credentials）
SLACK_SIGNING_SECRET=

# 氏名の取得に使う Bot トークン（OAuth & Permissions → Bot User OAuth Token）
SLACK_BOT_TOKEN=

# 画面の Basic 認証（2人で共有）
BASIC_AUTH_USER=ergon
BASIC_AUTH_PASSWORD=
